      end>
  end
  object QrySomaItemCancelar: TFDQuery
    Connection = ConnectFirebird
    SQL.Strings = (
      'SELECT '
      
        '--SUM(CASE WHEN QUANTIDADE>0 AND STATUS<>'#39'C'#39' THEN QUANTIDADE  EL' +
        'SE 0 END) AS VENDIDO,'
      
        '--SUM((CASE WHEN QUANTIDADE<0 AND STATUS='#39'C'#39' THEN QUANTIDADE ELS' +
        'E 0 END) *-1) AS CANCELADO'
      
        'SUM((CASE WHEN  STATUS<>'#39'C'#39' THEN QUANTIDADE ELSE 0 END)) AS VEND' +
        'IDO,'
      
        'SUM((CASE WHEN  STATUS='#39'C'#39' THEN QUANTIDADE ELSE 0 END)*-1) AS CA' +
        'NCELADO'
      ''
      'FROM VENDAs_ITEns'
      'WHERE'
      'CODIGOBARRA=:CBARRA')
    Left = 377
    Top = 366
    ParamData = <
      item
        Name = 'CBARRA'
        DataType = ftString
        ParamType = ptInput
        Value = Null
      end>
  end
  object QryCalcularVenda: TFDQuery
    Connection = ConnectFirebird
    SQL.Strings = (
      'SELECT '
      'COUNT((CASE WHEN STATUS<>'#39'C'#39' THEN ITEM  END)) AS QTDITENS,'
      
        'COUNT((CASE WHEN STATUS='#39'C'#39' THEN ITEM  END)) AS  QTDITENSCANCELA' +
        'DOS,'
      
        'COUNT((CASE WHEN STATUS<>'#39'C'#39' AND BALANCA='#39'S'#39' THEN ITEM  END)) AS' +
        ' QTDITENSBALANCA,'
      'COALESCE(SUM(VLR_DESCONTO),0) AS VLRDESCONTO,'
      'COALESCE(SUM(VLR_UNIT*QUANTIDADE),0) AS VALORPRODUTOS,'
      '--COALESCE(SUM(VLR_TOTAL),0) AS VALORPRODUTOS,'
      'COALESCE(SUM(VPIS),0) AS VALORPIS,'
      'COALESCE(SUM(VCOFINS),0) AS VALORCOFINS,'
      'COALESCE(SUM(VLR_ICMS),0) AS VALORICMS'
      'FROM VENDAS_ITENS'
      'WHERE'
      'CODIGO=:ID')
    Left = 377
    Top = 422
    ParamData = <
      item
        Name = 'ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
